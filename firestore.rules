rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: uid
    // Fields:
    //   - uid: string (required, immutable)
    //   - email: string (required)
    //   - name: string (required)
    //   - photoURL: string (optional)
    //   - role: string (required, enum: ['admin', 'trainer', 'member'])
    //   - createdAt: number (required, immutable)
    //
    // Collection: memberProfiles
    // Document ID: userId
    // Fields:
    //   - userId: string (required, immutable)
    //   - phone: string (optional)
    //   - dob: string (optional)
    //   - gender: string (optional)
    //   - height: number (optional)
    //   - weight: number (optional)
    //   - medicalConditions: string (optional)
    //   - trainerId: string (optional)
    //   - membershipPlanId: string (optional)
    //   - startDate: number (optional)
    //   - expiryDate: number (optional)
    //   - status: string (required, enum: ['Active', 'Inactive'])
    //
    // Collection: classes
    // Document ID: classId
    // Fields:
    //   - name: string (required)
    //   - trainerId: string (required)
    //   - capacity: number (required)
    //   - enrolled: number (required)
    //   - time: string (required)
    //   - duration: string (optional)
    //   - type: string (required)
    //
    // Collection: workoutPlans
    // Document ID: planId
    // Fields:
    //   - name: string (required)
    //   - trainerId: string (required)
    //   - memberId: string (required)
    //   - days: list (required)
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    
    function isAdmin() {
      return isAuthenticated() && (
        getUserRole() == 'admin' || 
        (request.auth.token.email == "ajithpithu@gmail.com" && request.auth.token.email_verified == true)
      );
    }
    
    function isTrainer() {
      return isAuthenticated() && getUserRole() == 'trainer';
    }
    
    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }
    
    function uidUnchanged() {
      return !('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid;
    }
    
    function uidNotModified() {
      return !('uid' in request.resource.data) || request.resource.data.uid == resource.data.uid;
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    function isValidUser(data) {
      return data.uid is string && data.uid.size() > 0 && data.uid.size() < 100 &&
             data.email is string && data.email.size() > 0 && data.email.size() < 100 &&
             data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() < 500)) &&
             data.role in ['admin', 'trainer', 'member'] &&
             data.createdAt is number;
    }
    
    function isValidMemberProfile(data) {
      return data.userId is string && data.userId.size() > 0 && data.userId.size() < 100 &&
             data.status in ['Active', 'Inactive'] &&
             (!('phone' in data) || (data.phone is string && data.phone.size() < 20)) &&
             (!('dob' in data) || (data.dob is string && data.dob.size() < 20)) &&
             (!('gender' in data) || (data.gender is string && data.gender.size() < 20)) &&
             (!('height' in data) || data.height is number) &&
             (!('weight' in data) || data.weight is number) &&
             (!('medicalConditions' in data) || (data.medicalConditions is string && data.medicalConditions.size() < 1000)) &&
             (!('trainerId' in data) || (data.trainerId is string && data.trainerId.size() < 100)) &&
             (!('membershipPlanId' in data) || (data.membershipPlanId is string && data.membershipPlanId.size() < 100)) &&
             (!('startDate' in data) || data.startDate is number) &&
             (!('expiryDate' in data) || data.expiryDate is number);
    }

    function isValidClass(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.trainerId is string && data.trainerId.size() > 0 && data.trainerId.size() < 100 &&
             data.capacity is number && data.capacity > 0 &&
             data.enrolled is number && data.enrolled >= 0 && data.enrolled <= data.capacity &&
             data.time is string && data.time.size() > 0 && data.time.size() < 50 &&
             (!('duration' in data) || (data.duration is string && data.duration.size() < 50)) &&
             data.type is string && data.type.size() > 0 && data.type.size() < 50;
    }

    function isValidWorkoutPlan(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.trainerId is string && data.trainerId.size() > 0 && data.trainerId.size() < 100 &&
             data.memberId is string && data.memberId.size() > 0 && data.memberId.size() < 100 &&
             data.days is list && data.days.size() <= 31;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId} {
      // Any authenticated user can read user profiles (needed for names/avatars)
      allow read: if isAuthenticated();
      
      // Users can create their own profile, but only as 'member' unless they are admin
      allow create: if isAuthenticated() && 
                    hasRequiredFields(['uid', 'email', 'name', 'role', 'createdAt']) &&
                    isValidUser(request.resource.data) && 
                    uidUnchanged() &&
                    ((isOwner(userId) && request.resource.data.role == 'member') || isAdmin());
                    
      // Users can update their own profile, but cannot change their role or uid unless admin
      allow update: if isAuthenticated() && 
                    isValidUser(request.resource.data) && 
                    uidNotModified() &&
                    request.resource.data.createdAt == resource.data.createdAt &&
                    ((isOwner(userId) && request.resource.data.role == resource.data.role) || isAdmin());
                    
      allow delete: if isAdmin();
    }

    match /memberProfiles/{userId} {
      // Admins and trainers can read all member profiles. Members can read their own.
      allow read: if isAdmin() || isTrainer() || isOwner(userId);
      
      // Admins can create/update. Members can update their own non-sensitive info.
      allow create: if isAdmin() && 
                    hasRequiredFields(['userId', 'status']) &&
                    isValidMemberProfile(request.resource.data);
                    
      allow update: if (isAdmin() && isValidMemberProfile(request.resource.data)) ||
                    (isOwner(userId) && isValidMemberProfile(request.resource.data) && 
                     request.resource.data.userId == resource.data.userId &&
                     request.resource.data.status == resource.data.status &&
                     request.resource.data.membershipPlanId == resource.data.membershipPlanId &&
                     request.resource.data.expiryDate == resource.data.expiryDate);
                     
      allow delete: if isAdmin();
    }

    match /classes/{classId} {
      // Anyone authenticated can view classes
      allow read: if isAuthenticated();
      
      // Admins and trainers can create/update/delete classes
      allow create: if (isAdmin() || isTrainer()) && 
                    hasRequiredFields(['name', 'trainerId', 'capacity', 'enrolled', 'time', 'type']) &&
                    isValidClass(request.resource.data);
                    
      allow update: if (isAdmin() || isTrainer()) && 
                    isValidClass(request.resource.data);
                    
      allow delete: if isAdmin() || isTrainer();
    }

    match /workoutPlans/{planId} {
      // Admins, the assigned trainer, and the assigned member can read
      allow read: if isAdmin() || 
                  (isAuthenticated() && resource.data.trainerId == request.auth.uid) ||
                  (isAuthenticated() && resource.data.memberId == request.auth.uid);
                  
      // Admins and trainers can create/update
      allow create: if (isAdmin() || isTrainer()) && 
                    hasRequiredFields(['name', 'trainerId', 'memberId', 'days']) &&
                    isValidWorkoutPlan(request.resource.data);
                    
      allow update: if (isAdmin() || isTrainer()) && 
                    isValidWorkoutPlan(request.resource.data);
                    
      allow delete: if isAdmin() || isTrainer();
    }
  }
}
